# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Define build arguments for Vite (Required for bundling)
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GITHUB_CLIENT_ID
ARG VITE_GOOGLE_REDIRECT_URI
ARG VITE_GITHUB_REDIRECT_URI

# Copy package files
COPY package*.json ./

# Configure npm for stability
RUN npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000 && \
    npm config set fetch-timeout 300000

# Install dependencies (All dependencies needed for building)
RUN npm ci

# Copy source code
COPY . .

# Set environment variables for Vite build process
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_GITHUB_CLIENT_ID=$VITE_GITHUB_CLIENT_ID
ENV VITE_GOOGLE_REDIRECT_URI=$VITE_GOOGLE_REDIRECT_URI
ENV VITE_GITHUB_REDIRECT_URI=$VITE_GITHUB_REDIRECT_URI

# Build the application
RUN npm run build

# Stage 2: Production (Nginx)
FROM nginx:stable-alpine

# Use a custom Nginx config that handles SPA routing (History API)
# Ensure you have an nginx.conf in your project root or this will fail
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Create non-root user and set permissions
# Nginx image already has a 'nginx' user (uid 101)
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx /etc/nginx/conf.d /usr/share/nginx/html

# Switch to non-root user
USER nginx

# Expose standard port
EXPOSE 80

# Health check using wget (standard in alpine)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:80/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
